[
  {
    "type": "function",
    "function": {
      "name": "get_workout_history",
      "description": "Strength workouts newest first: duration, feeling, sets, volume. status planned = not started.",
      "parameters": {
        "type": "object",
        "properties": {
          "start_date": {
            "type": "string",
            "description": "From (YYYY-MM-DD)."
          },
          "end_date": {
            "type": "string",
            "description": "To (YYYY-MM-DD)."
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "in_progress",
              "planned",
              "all"
            ],
            "description": "Default completed."
          },
          "limit": {
            "type": "integer",
            "description": "Default 10.",
            "maximum": 30
          },
          "page": {
            "type": "integer",
            "description": "Default 1."
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_workout_detail",
      "description": "One workout: every exercise and set, records set, comparison with the previous similar session.",
      "parameters": {
        "type": "object",
        "properties": {
          "workout_id": {
            "type": "string",
            "description": "Id from get_workout_history."
          }
        },
        "required": [
          "workout_id"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_exercises",
      "description": "Exercises with sessions and last trained date. Name search works in English and Portuguese; sort=least_recent finds neglected ones.",
      "parameters": {
        "type": "object",
        "properties": {
          "name_contains": {
            "type": "string",
            "description": "Part of the name."
          },
          "category_id": {
            "type": "string",
            "description": "From get_training_summary group_by=category."
          },
          "sort": {
            "type": "string",
            "enum": [
              "name",
              "most_recent",
              "least_recent"
            ],
            "description": "Default name."
          },
          "limit": {
            "type": "integer",
            "description": "Default 20.",
            "maximum": 50
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
