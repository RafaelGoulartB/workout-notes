      "parameters": {
        "type": "object",
        "properties": {
          "exercise_id": {
            "type": "string",
            "description": "Id from list_exercises."
          },
          "days": {
            "type": "integer",
            "description": "Last N days (default all).",
            "minimum": 1,
            "maximum": 3650
          },
          "limit": {
            "type": "integer",
            "description": "Default 8.",
            "maximum": 30
          }
        },
        "required": [
          "exercise_id"
        ]
      }
    }
  },
