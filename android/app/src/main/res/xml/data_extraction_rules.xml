<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Images attached to AI Coach messages stay on this device:
     they are neither backed up to the cloud nor copied to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="ai_chat_images/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="ai_chat_images/" />
    </device-transfer>
</data-extraction-rules>
